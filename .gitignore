# ── 运行时数据（本地数据库、SDE 下载缓存、ESI 响应缓存）──────────────
# industry.db 里会保存 DPAPI 加密后的刷新令牌，绝对不要提交
data/

# ── 本地配置 ──────────────────────────────────────────────────────────
# 可能包含 EVE 应用的 client_id / client_secret
config.json

# ── 内置运行时（便携版用；由 打包便携版.bat 下载生成，约 11 MB）──────
runtime/
build/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# ── 打包产物 ──────────────────────────────────────────────────────────
*.zip

# ── 编辑器 / 系统 ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
*.log
